# Локальная конфигурация backend.
# Скопируйте в backend/.env (scripts/start-local.ps1 делает это автоматически).
# Значения ниже подходят для локального запуска без Docker и PostgreSQL.

ENVIRONMENT=local

# Локальная SQLite. Путь можно не указывать — по умолчанию используется
# backend/data/requests.db независимо от текущей рабочей директории.
# DATABASE_URL=sqlite:///data/requests.db

# Продакшен (пример, НЕ включать локально без PostgreSQL):
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@db:5432/requests

# Cookie сессии. Для локального HTTP оставьте false, в продакшене — true.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ограничение попыток входа
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
SESSION_TTL_HOURS=12

# Telegram / aiogram. Токен хранится только в .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Отправка уведомлений сегодня выключена. Очередь только накапливает задания.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_POLL_SECONDS=3
NOTIFICATIONS_MAX_ATTEMPTS=5

# Первичная инициализация. Если пароли не заданы, bootstrap сгенерирует их
# один раз и сохранит в backend/data/local_credentials.txt (файл вне Git).
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OPERATOR_LOGIN=operator
BOOTSTRAP_OPERATOR_PASSWORD=
