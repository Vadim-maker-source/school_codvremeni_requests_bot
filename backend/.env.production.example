ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@db:5432/requests
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://YOUR_HOST
SESSION_TTL_HOURS=12
NOTIFICATIONS_ENABLED=false
# Set bootstrap passwords securely before first initialization. Never commit real values.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_OPERATOR_PASSWORD=
